# ============================================================
# LLM Configuration - Choose your brain
# ============================================================
# PRIMARY_LLM: Which provider is the main brain
#   "zai"    = z.ai (Zhipu GLM) - recommended, cost-effective
#   "openai" = OpenAI GPT models
#
# LLM_STRATEGY: How the other provider is used
#   "solo"     = don't use a secondary brain at all
#   "fallback" = call the secondary ONLY if the primary fails (default)
#   "verify"   = after every reply, the secondary double-checks primary output
#                and MohaMind auto-regenerates if issues are found
#
# SECONDARY_LLM: Which provider plays the secondary role
#   "zai" | "openai" | "none"
#
# FALLBACK_LLM (legacy): kept for backwards compatibility.
#                        If set to "none" it forces LLM_STRATEGY=solo.
# ============================================================

# --- z.ai (Zhipu GLM) ---
# Get your API key from: https://z.ai
ZAI_API_KEY=your-zai-api-key
ZAI_MODEL=glm-5-turbo
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# --- OpenAI ---
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Optional: point at a custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Selection ---
PRIMARY_LLM=zai
LLM_STRATEGY=fallback
SECONDARY_LLM=openai
FALLBACK_LLM=openai

# --- Verifier tuning (only used when LLM_STRATEGY=verify) ---
# VERIFIER_STRICTNESS: lenient | balanced | strict
VERIFIER_STRICTNESS=balanced
# How many times the primary can be retried after a critique (0-3)
VERIFIER_MAX_RETRIES=1

# ============================================================
# Telegram Bot
# ============================================================
# Create bot via @BotFather on Telegram
# Get your chat_id by messaging @userinfobot
#
# OWNER LOCK: only TELEGRAM_CHAT_ID (and TELEGRAM_ALLOWED_USER_IDS) can talk
# to the bot. Everyone else is refused — your memory stays private even if
# a stranger discovers the bot's username. If you leave TELEGRAM_CHAT_ID
# empty, the bot stays locked and replies to any message with the chat ID
# you should paste here.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
# Optional: extra user IDs (comma-separated) also allowed to use the bot,
# e.g. a spouse's Telegram account. Personal USER IDs only — never put a
# group chat ID here, or everyone in that group would be allowed in.
TELEGRAM_ALLOWED_USER_IDS=
# Set to "false" to disable /forget, /untask, /delete_note from Telegram.
TELEGRAM_ALLOW_DESTRUCTIVE=true

# Telegram access and scheduled messages require private user chats.
# Allowed users share this instance's memory; use separate instances for separate people.

# Local multilingual Whisper transcription (optional: uv sync --extra voice).
# Audio is transcribed locally. Confirmed text goes to the configured agent LLM.
# First use downloads the model unless VOICE_LOCAL_FILES_ONLY=true.
VOICE_ENABLED=false
VOICE_MODEL=small
VOICE_DEVICE=cpu
VOICE_COMPUTE_TYPE=int8
VOICE_LANGUAGE=auto
VOICE_CPU_THREADS=4
VOICE_MAX_DURATION_SECONDS=300
VOICE_MAX_FILE_MB=10
VOICE_LOCAL_FILES_ONLY=false

# ============================================================
# Google Calendar (optional)
# ============================================================
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_TOKEN_PATH=./credentials/google_token.json

# ============================================================
# Microsoft Graph / Outlook (optional)
# ============================================================
MS_CLIENT_ID=your-ms-client-id
MS_CLIENT_SECRET=your-ms-client-secret
MS_TENANT_ID=common
MS_TOKEN_PATH=./credentials/ms_token.json

# ============================================================
# Schedule & Timezone
# ============================================================
TIMEZONE=Asia/Riyadh
# Language for proactive messages (briefings, reminders, alerts) and
# Telegram command replies: "ar" or "en". Free-form chat always mirrors
# whatever language you write in.
AGENT_LANGUAGE=ar
MORNING_BRIEFING_TIME=08:00
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_TIME=19:00

# ============================================================
# Memory & Logging
# ============================================================
MEMORY_DIR=./memory
LOG_LEVEL=INFO

# ============================================================
# Memory Router + Summaries (Phase A)
# Keeps the system prompt compact as memory grows by summarizing
# un-needed categories and injecting only the relevant ones in full.
# ============================================================
MEMORY_ROUTER_ENABLED=true
MEMORY_ROUTER_MAX_CATEGORIES=4
MEMORY_SUMMARIES_ENABLED=true
MEMORY_SUMMARY_MODEL=

# ============================================================
# Semantic Memory (Phase B, OPT-IN)
# Enables concept-level recall across memory + daily_log + notes.
#   EMBEDDING_BACKEND=none    -> disabled (default, FTS5 only)
#   EMBEDDING_BACKEND=openai  -> uses OPENAI_API_KEY + text-embedding-3-small
#   EMBEDDING_BACKEND=local   -> requires optional 'sentence-transformers'
# ============================================================
EMBEDDING_BACKEND=none
EMBEDDING_MODEL=
SEMANTIC_TOP_K=5

# ============================================================
# Nightly Memory Consolidator (Phase C, OPT-IN)
# Once a day, reviews the last 24h of daily log + messages and extracts
# durable facts, observations, and conflicts.
#   CONSOLIDATOR_MODE=auto    -> applies everything silently
#   CONSOLIDATOR_MODE=confirm -> queues every proposal for approval
#   CONSOLIDATOR_MODE=hybrid  -> auto-applies safe additions, asks about
#                                conflicts and sensitive-category writes
# ============================================================
CONSOLIDATOR_ENABLED=false
CONSOLIDATOR_MODE=hybrid
CONSOLIDATOR_TIME=02:30
CONSOLIDATOR_SEND_DIGEST=true

# ============================================================
# Reliability Guardian (recommended ON)
# Daily memory integrity scan + rotating local ZIP backups.
# Backups are stored under memory/.backups/
# ============================================================
RELIABILITY_GUARDIAN_ENABLED=true
RELIABILITY_GUARDIAN_TIME=03:10
RELIABILITY_SEND_DIGEST=true
MEMORY_BACKUP_RETENTION_DAYS=30
MEMORY_BACKUP_MAX_COUNT=60

# ============================================================
# Privacy Tiers
# Comma-separated category list; these are redacted before leaving the
# primary agent (verifier, session store, daily log).
# ============================================================
SENSITIVE_CATEGORIES=finances,health,documents
PRIVACY_REDACT_SESSIONS=true
PRIVACY_REDACT_VERIFIER=true
PRIVACY_REDACT_DAILY_LOG=true
