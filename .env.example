# ============================================================
# LLM Configuration - Choose your brain
# ============================================================
# PRIMARY_LLM: Which LLM to use as the main brain
#   "zai"    = z.ai (Zhipu GLM) - recommended, cost-effective
#   "openai" = OpenAI GPT models
#
# FALLBACK_LLM: Which LLM to use if primary fails
#   "zai"    = fall back to z.ai
#   "openai" = fall back to OpenAI
#   "none"   = no fallback
# ============================================================

# --- z.ai (Zhipu GLM) ---
# Get your API key from: https://open.bigmodel.cn
# Works with OpenAI-compatible API
ZAI_API_KEY=your-zai-api-key
ZAI_MODEL=glm-4-plus
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# --- OpenAI ---
# Works with any OpenAI model
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Selection ---
PRIMARY_LLM=zai
FALLBACK_LLM=openai

# ============================================================
# Telegram Bot
# ============================================================
# Create bot via @BotFather on Telegram
# Get your chat_id by messaging @userinfobot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ============================================================
# Google Calendar (optional)
# ============================================================
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_TOKEN_PATH=./credentials/google_token.json

# ============================================================
# Microsoft Graph / Outlook (optional)
# ============================================================
MS_CLIENT_ID=your-ms-client-id
MS_CLIENT_SECRET=your-ms-client-secret
MS_TENANT_ID=common
MS_TOKEN_PATH=./credentials/ms_token.json

# ============================================================
# Schedule & Timezone
# ============================================================
TIMEZONE=Asia/Riyadh
MORNING_BRIEFING_TIME=08:00
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_TIME=19:00

# ============================================================
# Memory & Logging
# ============================================================
MEMORY_DIR=./memory
LOG_LEVEL=INFO
