__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
wheels/

# Virtual environments
.venv/
venv/

# Environment & Secrets
.env
.env.*
!.env.example
credentials/
*.token
*_token.json
*.pem
*.key
*.sqlite*
*.db
*.db-*
*.log
*.ogg
