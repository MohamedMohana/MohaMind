models/
backups/
node_modules/
# External MCP server config may embed API keys — keep it local.
mcp_servers.json

# Runtime logs (rotated by the app)
logs/

# Memory — PRIVATE. Ignore EVERYTHING under memory/ by default.
# Personal life data (health, finances, family, conversations, etc.) lives
# here and must never leave the local machine. The only things tracked
# are the structural scaffolds under memory/templates/, the memory README,
# and a .gitkeep placeholder.
memory/*
!memory/.gitkeep
!memory/README.md
!memory/templates/
!memory/templates/**

